<%- include('../partials/header', { title: 'New Task' }) %>

<div class="container">
  <h1 class="page-title">Create a New Task</h1>

  <form action="/tasks" method="POST" enctype="multipart/form-data" class="task-form">
    <div class="form-group">
      <label for="title">Title</label>
      <input type="text" name="title" id="title" placeholder="What needs to be done?" required>
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea name="description" id="description" rows="4" placeholder="Add details..."></textarea>
    </div>

    <div class="form-group">
      <label for="file">Attachment</label>
      <input type="file" name="file" id="file">
    </div>

    <div style="display:flex;gap:12px">
      <button type="submit" class="btn">Create Task</button>
      <a href="/tasks" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
